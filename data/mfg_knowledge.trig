# Core TBox for the manufacturing benchmark (v2).
#
# * MASON-inspired upper level: Entity / Operation / Resource (local ex: IRIs aligned by name;
#   MASON itself is not imported).
# * SOSA/SSN (real W3C IRIs): parts are sosa:FeatureOfInterest; drift specifications are
#   ssn:Property individuals; each part class carries an OWL hasValue restriction on ssn:hasProperty
#   that points to its specification, and the specification holds the threshold.
# * FMEA-style (local ex: classes; there is no single standard FMEA ontology):
#   Symptom -causedBy-> Cause -attributedTo-> Part, Cause -mitigatedBy-> Action, FailureMode.
#
# The ABox (ex:ABox_Graph) and write-time inferred types (ex:Inferred_Graph) are generated by
# src/common.py:generate_connected_fab_graph and loaded next to this file's TBox graph.

PREFIX ex:   <http://example.org/mfg#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX ssn:  <http://www.w3.org/ns/ssn/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

GRAPH ex:TBox_Graph {
  # --- MASON-style upper level and equipment hierarchy
  ex:Equipment          rdfs:subClassOf ex:Resource .
  ex:ProductionLine     rdfs:subClassOf ex:Resource .
  ex:Lot                rdfs:subClassOf ex:Entity .
  ex:ProcessChamber     rdfs:subClassOf ex:Equipment .
  ex:Module             rdfs:subClassOf ex:Equipment .
  ex:GasSupplyModule    rdfs:subClassOf ex:Module .
  ex:ThermalModule      rdfs:subClassOf ex:Module .
  ex:PlasmaModule       rdfs:subClassOf ex:Module .
  ex:Part               rdfs:subClassOf ex:Equipment , sosa:FeatureOfInterest .
  ex:MFC                rdfs:subClassOf ex:Part .
  ex:Seal               rdfs:subClassOf ex:Part .
  ex:Heater             rdfs:subClassOf ex:Part .
  ex:RFGenerator        rdfs:subClassOf ex:Part .

  # --- SOSA/SSN: class-level specification via OWL restrictions
  ex:DriftSpecification rdfs:subClassOf ssn:Property .
  ex:MFC         rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ssn:hasProperty ; owl:hasValue ex:FlowDriftSpec ] .
  ex:Heater      rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ssn:hasProperty ; owl:hasValue ex:TempDriftSpec ] .
  ex:RFGenerator rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ssn:hasProperty ; owl:hasValue ex:PowerDriftSpec ] .
  ex:Seal        rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ssn:hasProperty ; owl:hasValue ex:LeakRateSpec ] .
  ex:FlowDriftSpec  a ex:DriftSpecification ; ex:maxAllowedDrift "5.0"^^xsd:double .
  ex:TempDriftSpec  a ex:DriftSpecification ; ex:maxAllowedDrift "10.0"^^xsd:double .
  ex:PowerDriftSpec a ex:DriftSpecification ; ex:maxAllowedDrift "3.0"^^xsd:double .
  ex:LeakRateSpec   a ex:DriftSpecification ; ex:maxAllowedDrift "1.0"^^xsd:double .

  # --- FMEA classes
  ex:FailureMode rdfs:subClassOf ex:Entity .
  ex:Symptom     rdfs:subClassOf ex:FailureMode .
  ex:Cause       rdfs:subClassOf ex:Entity .
  ex:Action      rdfs:subClassOf ex:Operation .

  # --- object properties (transitivity is declared; queries use property paths, no reasoner)
  ex:partOf       a owl:TransitiveProperty .
  ex:feedsInto    a owl:TransitiveProperty .
  ex:causedBy     a owl:ObjectProperty .
  ex:attributedTo a owl:ObjectProperty .
  ex:mitigatedBy  a owl:ObjectProperty .
  ex:processedIn  a owl:ObjectProperty .
}
