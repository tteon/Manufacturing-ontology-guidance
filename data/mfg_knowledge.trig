# Semiconductor manufacturing toy knowledge base (MASON-style equipment
# hierarchy + SOSA observations + FMEA-style causal chains).
# TBox and ABox live in separate named graphs so their lifecycles can differ.
# Confidence annotations use RDF 1.2 reified triples: `<< s p o >> ex:confidence v`
# parses to `_:r rdf:reifies <<( s p o )>> . _:r ex:confidence v`.

PREFIX ex:   <http://example.org/mfg#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

GRAPH ex:TBox_Graph {
  ex:Equipment       a owl:Class .
  ex:Component       a owl:Class .
  ex:ProcessChamber  rdfs:subClassOf ex:Equipment .
  ex:GasSupplyModule rdfs:subClassOf ex:Equipment .
  ex:PlasmaModule    rdfs:subClassOf ex:Equipment .
  ex:ThermalModule   rdfs:subClassOf ex:Equipment .

  ex:CVDChamber   rdfs:subClassOf ex:ProcessChamber .
  ex:EtchChamber  rdfs:subClassOf ex:ProcessChamber .
  ex:LithoChamber rdfs:subClassOf ex:ProcessChamber .
  ex:MFC          rdfs:subClassOf ex:GasSupplyModule .
  ex:GasBox       rdfs:subClassOf ex:GasSupplyModule .
  ex:RFGenerator  rdfs:subClassOf ex:PlasmaModule .
  ex:Heater       rdfs:subClassOf ex:ThermalModule .
  ex:Seal         rdfs:subClassOf ex:Component .

  # Class-level sensor thresholds (inherited by instances via rdf:type).
  ex:MFC         ex:maxAllowedDrift "5.0"^^xsd:double .
  ex:RFGenerator ex:maxAllowedDrift "3.0"^^xsd:double .
  ex:Heater      ex:maxAllowedDrift "10.0"^^xsd:double .

  ex:partOf    a owl:TransitiveProperty .
  ex:feedsInto a owl:TransitiveProperty .
}

GRAPH ex:ABox_Graph {
  # Chambers and process flow
  ex:Chamber_CVD_01   a ex:CVDChamber ;  ex:feedsInto ex:Chamber_Etch_02 .
  ex:Chamber_Etch_02  a ex:EtchChamber .
  ex:Chamber_Litho_03 a ex:LithoChamber .

  # Sub-assemblies (partOf chain: ORing_Seal_04 -> MFC_01 -> GasBox_A -> Chamber_CVD_01)
  ex:GasBox_A      a ex:GasBox ;      ex:partOf ex:Chamber_CVD_01 .
  ex:MFC_01        a ex:MFC ;         ex:partOf ex:GasBox_A .
  ex:Heater_01     a ex:Heater ;      ex:partOf ex:Chamber_CVD_01 .
  ex:RF_Gen_01     a ex:RFGenerator ; ex:partOf ex:Chamber_Etch_02 .
  ex:ORing_Seal_04 a ex:Seal ;        ex:partOf ex:MFC_01 ; ex:hasDefect ex:Micro_Leak .

  # Lots
  ex:Lot_101 ex:processedIn ex:Chamber_CVD_01 ; ex:hasSymptom ex:Thickness_Anomaly .
  ex:Lot_102 ex:processedIn ex:Chamber_Etch_02 .
  ex:Lot_103 ex:processedIn ex:Chamber_Litho_03 .

  # FMEA causal chains with confidences (3 hops: symptom -> cause -> cause -> equipment)
  ex:Thickness_Anomaly    ex:causedBy     ex:DepositionRate_Drift .
  ex:DepositionRate_Drift ex:causedBy     ex:GasFlow_Instability .
  ex:DepositionRate_Drift ex:causedBy     ex:Temperature_Drift .
  ex:GasFlow_Instability  ex:attributedTo ex:MFC_01 .
  ex:Temperature_Drift    ex:attributedTo ex:Heater_01 .
  << ex:Thickness_Anomaly    ex:causedBy     ex:DepositionRate_Drift >> ex:confidence "0.90"^^xsd:double .
  << ex:DepositionRate_Drift ex:causedBy     ex:GasFlow_Instability  >> ex:confidence "0.85"^^xsd:double .
  << ex:DepositionRate_Drift ex:causedBy     ex:Temperature_Drift    >> ex:confidence "0.60"^^xsd:double .
  << ex:GasFlow_Instability  ex:attributedTo ex:MFC_01               >> ex:confidence "0.95"^^xsd:double .
  << ex:Temperature_Drift    ex:attributedTo ex:Heater_01            >> ex:confidence "0.90"^^xsd:double .

  # SOSA observations (current drift readings)
  ex:Obs_01 a sosa:Observation ; sosa:hasFeatureOfInterest ex:MFC_01 ;    sosa:hasSimpleResult "6.20"^^xsd:double .
  ex:Obs_02 a sosa:Observation ; sosa:hasFeatureOfInterest ex:RF_Gen_01 ; sosa:hasSimpleResult "3.80"^^xsd:double .
  ex:Obs_03 a sosa:Observation ; sosa:hasFeatureOfInterest ex:Heater_01 ; sosa:hasSimpleResult "4.00"^^xsd:double .
}
